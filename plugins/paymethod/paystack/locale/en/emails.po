msgid "emails.paystack.paymentConfirmation.subject"
msgstr "Payment received — {$contextName}"

msgid "emails.paystack.paymentConfirmation.body"
msgstr ""
"<p>Dear {$recipientName},</p>\n"
"<p>We have received your payment of <strong>{$paymentAmount} {$paymentCurrency}</strong> for {$paymentName}.</p>\n"
"<p>Reference: <strong>{$paymentReference}</strong><br />\n"
"Date: {$paymentDate}</p>\n"
"<p>Regards,<br />{$contextName}</p>"

msgid "emails.paystack.paymentConfirmationAdmin.subject"
msgstr "New Paystack payment — {$paymentReference}"

msgid "emails.paystack.paymentConfirmationAdmin.body"
msgstr ""
"<p>A payment of <strong>{$paymentAmount} {$paymentCurrency}</strong> has been completed.</p>\n"
"<p>Reference: {$paymentReference}<br />\n"
"Payer: {$payerName} ({$payerEmail})<br />\n"
"Item: {$paymentName}</p>\n"
"<p>{$contextName}</p>"

msgid "emails.paystack.paymentFailed.subject"
msgstr "Payment could not be completed — {$contextName}"

msgid "emails.paystack.paymentFailed.body"
msgstr ""
"<p>Dear {$recipientName},</p>\n"
"<p>Your Paystack payment could not be verified (reference {$paymentReference}).</p>\n"
"<p>If you were charged, please contact the journal with this reference.</p>\n"
"<p>Regards,<br />{$contextName}</p>"

msgid "emails.paystack.paymentRefunded.subject"
msgstr "Refund processed — {$contextName}"

msgid "emails.paystack.paymentRefunded.body"
msgstr ""
"<p>Dear {$recipientName},</p>\n"
"<p>A refund of <strong>{$paymentAmount} {$paymentCurrency}</strong> has been submitted for reference {$paymentReference}.</p>\n"
"<p>Regards,<br />{$contextName}</p>"
